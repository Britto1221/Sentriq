# Northstar development BFF. Set the application ID and key from a private
# development seed/bootstrap file; never place these values in client code.
SENTRIQ_API_BASE_URL=http://127.0.0.1:4000
SENTRIQ_APPLICATION_ID=
SENTRIQ_APPLICATION_KEY=
NORTHSTAR_PUBLIC_ORIGIN=http://localhost:3001

# Optional Sentriq Assistant integration. Leave OPENAI_API_KEY empty to use
# deterministic offline guidance. This key is read only by the Northstar server.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_MAX_OUTPUT_TOKENS=350
